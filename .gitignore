# ==========================================
# KisanDirect - Production .gitignore
# ==========================================

# Python Virtual Environments & Packages
venv/
backend/venv/
env/
.env/
ENV/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Byte-compiled / optimized / DLL files
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# Unit Tests & Caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Database (Keep Local Development DB Private)
*.db
*.sqlite
*.sqlite3
backend/marketplace.db
backend/*.db

# Node / Vite / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.local

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & OS Metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
*.log
