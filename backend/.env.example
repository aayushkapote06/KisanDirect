# KisanDirect Backend Configuration Example
# Copy this file to .env in production

SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database URL:
# For SQLite (default development): sqlite:///./marketplace.db
# For PostgreSQL (production e.g. Supabase, Render, Neon): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./marketplace.db
